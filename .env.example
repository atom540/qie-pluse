# QIE V3 AI Risk Oracle - Environment Configuration
# Copy this file to .env and fill in your actual values

# API Keys for Data Collection
COINGECKO_API_KEY=your_coingecko_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Telegram API (Optional - for sentiment analysis)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=your_phone_number

# QIE V3 Blockchain Configuration
QIE_RPC_URL=https://rpc.qie-pulse.com
QIE_RPC_BACKUP_URL=https://backup-rpc.qie-pulse.com
PRIVATE_KEY=your_wallet_private_key_here
AI_RISK_ORACLE_CONTRACT_ADDRESS=your_contract_address_here

# System Configuration
DEFAULT_GAS_LIMIT=100000
DEFAULT_GAS_PRICE=20000000000
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY=60.0

# Risk Assessment Configuration
RISK_THRESHOLD=0.85
BLOCKCHAIN_UPDATE_INTERVAL=300
BLOCKCHAIN_FORCE_UPDATE_INTERVAL=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/